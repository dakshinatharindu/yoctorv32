{
  "name": "yoctorv32 (Verilator + RV32IMA toolchain)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.VerilogHDL",
        "ms-vscode.cpptools",
        "anthropic.claude-code"
      ],
      "settings": {
        "files.associations": {
          "*.sv": "systemverilog",
          "*.svh": "systemverilog"
        }
      }
    }
  },
  "postCreateCommand": "verilator --version && riscv32-unknown-elf-gcc --version && gtkwave --version && bash /workspaces/yoctorv32/.devcontainer/setup-claude-persist.sh",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}
